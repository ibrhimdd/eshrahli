# انسخ الملف ده باسم .env واملأ القيم اللي محتاجها
PORT=4000

# اختياري: لو حطيت مفتاح هنا، السيرفر هيستخدم نموذج ذكاء اصطناعي حقيقي
# عشان يولّد خريطة ذهنية لأي موضوع مش موجود في المكتبة الجاهزة.
# لو سبته فاضي، السيرفر هيرجع خريطة عامة بديلة بدل ما يفشل.
ANTHROPIC_API_KEY=

# اسم الموديل اللي عايز تستخدمه (راجع https://docs.anthropic.com لأحدث الأسماء المتاحة)
ANTHROPIC_MODEL=claude-3-haiku-20240307
