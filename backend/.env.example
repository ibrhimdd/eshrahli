# Copy to .env locally. Never commit .env.
PORT=4000
NODE_ENV=development

# Required: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Comma-separated frontend origins. Empty allows all origins (local development only).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
APP_URL=http://localhost:4000
AI_TIMEOUT_MS=45000
